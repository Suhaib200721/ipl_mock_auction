# ================================================================
# IPL 2027 MOCK AUCTION - DEPLOYMENT ENVIRONMENT VARIABLES
# ================================================================

# ----------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ----------------------------------------------------------------
# Set this in your Vercel Project Settings -> Environment Variables.
# Replace with your actual live Render Web Service URL (NO trailing slash).
VITE_BACKEND_URL=https://ipl-auction-backend.onrender.com

# (Optional alias if preferred)
# VITE_SOCKET_URL=https://ipl-auction-backend.onrender.com


# ----------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Web Service)
# ----------------------------------------------------------------
# Render automatically injects PORT (defaults to 10000 on Render).
PORT=10000
NODE_ENV=production

# (Optional) Restrict CORS to your exact Vercel frontend URL.
# If omitted or left empty, all *.vercel.app origins and preview deployments are permitted automatically.
FRONTEND_URL=https://your-ipl-auction-frontend.vercel.app
