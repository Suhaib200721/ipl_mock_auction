{
  "name": "ipl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "concurrently -k -n \"SERVER,VITE\" -c \"cyan.bold,green.bold\" \"tsx server/index.ts\" \"vite\"",
    "dev:client": "vite",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -k -n \"SERVER,VITE\" -c \"cyan.bold,green.bold\" \"tsx server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "build:client": "vite build",
    "test": "tsx test/auctionEngine.test.ts && tsx test/multiplayerEngine.test.ts && tsx test/stage3TeamClaim.test.ts && tsx test/stage4AiTeamAnalysis.test.ts && tsx test/setAndSkipOptions.test.ts && tsx test/opponentBidding.test.ts && tsx test/retentionAndRanking.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}